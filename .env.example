# Copy to .env and fill in per-deployment.
# Currently unused by the services themselves — no service reads any env
# vars yet. Real variables land here as each service needs them.

# Which music-source fetcher containers to build/run — Docker Compose's
# own profile mechanism (docker-compose.yml), one profile per source,
# matching config/global.yaml's sources.*.enabled flags. Compose doesn't
# read global.yaml itself, so keep these two in sync by hand. Only
# list the sources this household actually uses — e.g. an
# Apple-Music-only household should just have "apple" here, not all
# three. library-manager/podcast-manager always run regardless, no
# profile needed for those.
#
# COMPOSE_PROFILES=apple
# COMPOSE_PROFILES=apple,spotify,ytmusic

# --- web-gui-backend (docker-compose.yml) --------------------------------
# Read directly by docker-compose.yml itself (variable interpolation),
# not by the app.

# Host port to publish the web GUI on. Change if 8420 is already taken.
# WEB_GUI_PORT=8420

# Where this host auto-mounts removable media -- bind-mounted (with
# rslave propagation) into web-gui-backend's container so it can see a
# freshly-connected, host-mounted iPod without a container restart.
# Check with `mount | grep -i ipod` (or `lsblk -o NAME,LABEL,MOUNTPOINT`)
# after plugging one in if you're not sure which your distro uses.
# Arch/Manjaro (udisks2 default): /run/media
# Debian/Ubuntu (udisks2 default): /media/<your actual username>
#   .env is a plain KEY=VALUE file, NOT a shell script -- "$USER" here
#   would be taken 100% literally, not expanded to your real username.
#   Confirmed live: this exact mistake produced "bind source path does
#   not exist: /media/$USER".
# HOST_MEDIA_ROOT=/run/media
#
# Whatever path you set (or the /run/media default above) MUST already
# exist on the host before your first `docker compose up`/`docker-
# compose up` -- Compose does not reliably auto-create a missing bind
# mount source across versions (confirmed live both ways: newer Compose
# needs an explicit, opt-in `create_host_path` this repo can't assume
# every deploy target supports -- docker-compose v1 doesn't have that
# field in its schema at all and hard-rejects the whole file if it's
# present). If nothing's ever auto-mounted anything on this host yet:
#   sudo mkdir -p /run/media/<your actual username>   # or your real path

# A profile's external_library.path (ExternalLibraryConfig, set via the
# web GUI's "External library" screen or by hand in
# config/profiles/<you>.yaml) is a real host path used as-is -- unlike
# config/library/state, it is NOT remapped to a fixed /config- or
# /data-style container path, because sync-orchestrator (bare metal)
# needs that exact same real path too. Set this to that same path so
# web-gui-backend's container can browse/read it too -- it's bind-mounted
# to the identical path inside the container (so it too MUST already
# exist -- same reasoning as HOST_MEDIA_ROOT above). Only needed if you
# actually use this feature; leave unset otherwise. Multiple profiles
# with *different* external_library paths need one bind-mount line per
# path added by hand in docker-compose.yml, following the same pattern.
# EXTERNAL_LIBRARY_PATH=/home/you/Music/MusicLibrary

# Same idea for AudiobookManagerConfig.discover_root (global, not
# per-profile -- the "Discover new audiobooks" drop-zone folder the
# Audiobooks screen scans). Also MUST already exist if set.
# AUDIOBOOK_DISCOVER_ROOT=/home/you/Music/audiobook-drop-zone
